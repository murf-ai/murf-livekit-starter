# =============================================================================
# Frontend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport — must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch (optional)
# Leave blank for automatic dispatch; set to agent name for explicit dispatch.
# See https://docs.livekit.io/agents/server/agent-dispatch
# -----------------------------------------------------------------------------
AGENT_NAME=mitra

# -----------------------------------------------------------------------------
# Twilio Voice (server-side only; never prefix these with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TO_NUMBER=
PUBLIC_BASE_URL=

# LiveKit telephony endpoint used by Twilio to bridge the call to Mitra.
LIVEKIT_SIP_URI=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# -----------------------------------------------------------------------------
# Local Commerce outbound order
# -----------------------------------------------------------------------------
ORDER_CUSTOMER_NAME=Shivam
ORDER_ID=ORD-1001
ORDER_ITEMS=1 x Amul Taaza Milk, 1 litre pouch, INR 68, seller Sharma General Store|1 x Britannia Brown Bread, 400 gram loaf, INR 45, seller Sharma General Store|1 x Homemade Mango Pickle, 500 gram jar, INR 240, seller Asha Foods
ORDER_TOTAL_INR=353
ORDER_DELIVERY_TIME=Today, 6 PM-8 PM

# -----------------------------------------------------------------------------
# Optional — LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=
