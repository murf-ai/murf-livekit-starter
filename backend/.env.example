# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# LLM — NVIDIA Nemotron-3-Nano-30B (default)
# Get nvapi key from https://build.nvidia.com
# -----------------------------------------------------------------------------
OPENAI_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Legacy Gemini (no longer used):
# GOOGLE_API_KEY=your_google_api_key_here


# -----------------------------------------------------------------------------
# Day 7 — Human escalation
# Optional webhook (helpdesk / dashboard). If empty, tickets still persist in
# SQLite (data/caller_memory.db) and data/escalation_dispatch.log
# -----------------------------------------------------------------------------
# ESCALATION_WEBHOOK_URL=https://example.com/hooks/jan-sahay-escalation

# Day 6/7 telephony (Linphone or Twilio)
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_trunk_id
# LINPHONE_SIP_URI=sip:your_username@sip.linphone.org
# SIP_OUTBOUND_HOST=sip.linphone.org
# TRANSFER_TO_NUMBER=
